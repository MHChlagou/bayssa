{
  "name": "bayssa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run content:build && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run content:build && vitest run",
    "test:watch": "vitest",
    "build:update-fixture": "vite build --mode update-fixture --outDir dist-next --emptyOutDir",
    "test:e2e": "npm run build:update-fixture && playwright test",
    "build:public": "CONTENT_RIGHTS=cleared npm run build -- --outDir dist-public --emptyOutDir && node scripts/check-public-build.ts dist-public; status=$?; npm run content:build; exit $status",
    "test:public": "playwright test -c playwright.public.config.ts",
    "content:fetch": "node scripts/fetch-sources.ts",
    "content:import": "node scripts/import-content.ts",
    "content:build": "node scripts/build-content.ts",
    "content:audit": "node scripts/audit-content.ts",
    "content:validate": "node scripts/build-content.ts --check",
    "icons": "node scripts/generate-icons.ts && node scripts/generate-splash.ts"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
